{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "title": "AgriDecision AI — API Performance",
  "uid": "agridecision-api-performance",
  "tags": ["agridecision", "api"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Requests Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (service)", "legendFormat": "{{service}}" }]
    },
    {
      "id": 2,
      "title": "HTTP Status Code Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(http_requests_total[5m])) by (status)", "legendFormat": "HTTP {{status}}" }]
    },
    {
      "id": 3,
      "title": "2xx vs 4xx vs 5xx Breakdown",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(http_requests_total{status=~\"2..\"}[5m]))", "legendFormat": "Success (2xx)" },
        { "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m]))", "legendFormat": "Client Errors (4xx)" },
        { "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "Server Errors (5xx)" }
      ]
    }
  ]
}

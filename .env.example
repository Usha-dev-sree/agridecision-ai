# Environment Variable Template — AgriDecision AI
# =============================================
# Copy this file to .env.local and fill in values for local development.
# NEVER commit actual secrets to version control.
# Use HashiCorp Vault for all production secrets.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=DEBUG

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://agridecision:changeme@localhost:5432/agridecision_dev
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── TimescaleDB (same cluster, different schema) ──────────────────────────────
TIMESCALE_URL=postgresql://agridecision:changeme@localhost:5432/agridecision_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=agridecision-local

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_VAULT
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# ── SMS Gateway ───────────────────────────────────────────────────────────────
SMS_GATEWAY_URL=http://localhost:8089/v1/sms/send
SMS_GATEWAY_TOKEN=mock_token_for_local_dev

# ── Firebase (Push Notifications) ────────────────────────────────────────────
FIREBASE_PROJECT_ID=agridecision-local
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# ── HashiCorp Vault ───────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# ── Triton Inference Server ────────────────────────────────────────────────────
TRITON_GRPC_URL=localhost:8001
TRITON_HTTP_URL=http://localhost:8000

# ── Feast Feature Store ───────────────────────────────────────────────────────
FEAST_REGISTRY_PATH=./ai_services/feature_store/registry/local_registry.db
FEAST_ONLINE_STORE_HOST=localhost

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ── AWS / Object Storage ──────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=local_dev_key
AWS_SECRET_ACCESS_KEY=local_dev_secret
S3_DATA_LAKE_BUCKET=agridecision-data-lake-dev
S3_ENDPOINT_URL=http://localhost:9000

# ── Weather Data APIs ─────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY_HERE
IMD_API_KEY=YOUR_IMD_KEY_HERE

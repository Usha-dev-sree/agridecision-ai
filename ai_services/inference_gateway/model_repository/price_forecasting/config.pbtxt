name: "price_forecasting"
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [ 30, 3 ]
  }
]

output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 7 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 8000
}

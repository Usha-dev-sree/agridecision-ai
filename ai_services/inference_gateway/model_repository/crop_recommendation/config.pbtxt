name: "crop_recommendation"
platform: "onnxruntime_onnx"
max_batch_size: 16

input [
  {
    name: "float_input"
    data_type: TYPE_FP32
    dims: [ 7 ]
  }
]

output [
  {
    name: "output_label"
    data_type: TYPE_INT64
    dims: [ 1 ]
  },
  {
    name: "output_probability"
    data_type: TYPE_FP32
    dims: [ 8 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
  }
]

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

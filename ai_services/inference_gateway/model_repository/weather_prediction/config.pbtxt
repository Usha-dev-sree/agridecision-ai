name: "weather_prediction"
platform: "onnxruntime_onnx"
max_batch_size: 64

input [
  {
    name: "float_input"
    data_type: TYPE_FP32
    dims: [ 5 ]
  }
]
output [
  {
    name: "variable"
    data_type: TYPE_FP32
    dims: [ 3 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

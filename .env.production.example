# AgriDecision AI - Production Environment Variables Template
# Copy to .env.production on target server / secrets vault

# ─── Environment & Domain Configuration ──────────────────────────────────────
NODE_ENV=production
ENVIRONMENT=production
DOMAIN_NAME=agridecision.ai
API_BASE_URL=https://api.agridecision.ai

# ─── PostgreSQL Primary Database ─────────────────────────────────────────────
POSTGRES_HOST=rds-postgres.agridecision.internal
POSTGRES_PORT=5432
POSTGRES_DB=agridecision_user
POSTGRES_USER=agri_prod_user
POSTGRES_PASSWORD=CHANGEME_IN_PRODUCTION_STRONG_DB_PASS_32_CHARS
DATABASE_URL=postgresql://agri_prod_user:CHANGEME_IN_PRODUCTION_STRONG_DB_PASS_32_CHARS@rds-postgres.agridecision.internal:5432/agridecision_user

# ─── TimescaleDB Geo-Spatial Database ────────────────────────────────────────
TIMESCALE_HOST=timescale.agridecision.internal
TIMESCALE_PORT=5432
TIMESCALE_DB=agridecision_farm
TIMESCALE_USER=agri_farm_user
TIMESCALE_PASSWORD=CHANGEME_IN_PRODUCTION_STRONG_TIMESCALE_PASS
TIMESCALE_URL=postgresql://agri_farm_user:CHANGEME_IN_PRODUCTION_STRONG_TIMESCALE_PASS@timescale.agridecision.internal:5432/agridecision_farm

# ─── Redis Cache & Rate Limiting ─────────────────────────────────────────────
REDIS_HOST=elasticache-redis.agridecision.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_IN_PRODUCTION_REDIS_AUTH_PASS
REDIS_URL=redis://:CHANGEME_IN_PRODUCTION_REDIS_AUTH_PASS@elasticache-redis.agridecision.internal:6379/0

# ─── Kafka Event Bus ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=b-1.msk-kafka.us-east-1.amazonaws.com:9092,b-2.msk-kafka.us-east-1.amazonaws.com:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=AWS_MSK_IAM

# ─── Security & JWT Secret Keys ──────────────────────────────────────────────
JWT_SECRET_KEY=CHANGEME_IN_PRODUCTION_JWT_SECRET_64_HEX_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
FIELD_ENCRYPTION_KEY=CHANGEME_IN_PRODUCTION_AES256_KEY_64_HEX_CHARACTERS

# ─── Third-Party Services ───────────────────────────────────────────────────
OPENWEATHER_API_KEY=CHANGEME_PRODUCTION_OPENWEATHER_API_KEY
AWS_REGION=us-east-1
S3_BUCKET_MEDIA=agridecision-production-media-assets
S3_BUCKET_MODELS=agridecision-production-model-repository

# ─── HashiCorp Vault ────────────────────────────────────────────────────────
VAULT_ADDR=https://vault.agridecision.internal:8200
VAULT_ROLE=agridecision-microservices-role
